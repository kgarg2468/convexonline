    "deploy": "npx convex deploy -y && npx @convex-dev/static-hosting upload --build --prod"
  },
  "dependencies": {
    "@auth/core": "^0.41.3",
    "@convex-dev/auth": "^0.0.95",
    "@convex-dev/presence": "0.4.0",
    "@convex-dev/static-hosting": "^0.2.1",
    "convex": "^1.46.0",
    "react": "^19.3.0",
    "react-dom": "^19.3.0"
  },
  "devDependencies": {
    "@edge-runtime/vm": "^5.0.0",
    "@types/node": "^22.20.4",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.1.1",
    "convex-test": "^0.0.59",
    "oxlint": "^1.83.0",
    "typescript": "~5.9",
    "vite": "^8.3.0",
    "vitest": "^3.2.7"
  }
}
